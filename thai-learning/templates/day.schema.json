{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personalized Thai daily review pack",
  "type": "object",
  "required": [
    "schema_version",
    "day",
    "lesson_id",
    "revision",
    "status",
    "sentences",
    "voices",
    "audio_program"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "lesson_id": {"type": "string", "pattern": "^day-[0-9]{3}$"},
    "revision": {"type": "integer", "minimum": 1},
    "day": {"type": "integer", "minimum": 1},
    "status": {
      "enum": ["pending_review", "approved", "retired"]
    },
    "sentences": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "prompt_he",
          "thai",
          "romanization",
          "literal_he",
          "context_he",
          "pattern",
          "variation",
          "review_status"
        ],
        "properties": {
          "review_status": {
            "enum": ["pending", "approved", "rejected"]
          }
        }
      }
    },
    "voices": {
      "type": "object",
      "required": ["provider", "thai", "hebrew"],
      "properties": {
        "provider": {"const": "azure_speech"},
        "thai": {"type": "string"},
        "hebrew": {"type": "string"}
      }
    },
    "audio_program": {
      "type": "object",
      "required": ["tracks", "normal_speed_only"],
      "properties": {
        "normal_speed_only": {"const": true},
        "tracks": {"type": "array", "minItems": 1}
      }
    }
  }
}
